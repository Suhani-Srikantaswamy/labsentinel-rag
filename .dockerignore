.env
.env.*
!.env.example

# Local environments / caches
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
.DS_Store
.idea/
.vscode/

# Large or generated data — mounted as volumes instead
data/videos/
data/embeddings/
outputs/
