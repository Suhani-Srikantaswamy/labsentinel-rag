{% if not embedded %}<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LabSentinel-RAG Investigation Report</title>
  <style>
{% include "_styles.css.j2" %}
  </style>
</head>
<body class="lsr-page">
{% else %}
<style>
{% include "_styles.css.j2" %}
</style>
{% endif %}
<div class="lsr{% if not embedded %} page{% endif %}" id="lsr-report" data-report-id="{{ r.report_id }}">

{% if not embedded %}
<div class="header">
  <h1>🔬 LabSentinel-RAG — Investigation Report</h1>
  <p>Report ID: {{ r.report_id }} · {{ generated_at }} · {{ r.video_path.split('/')[-1] }}</p>
</div>
{% if include_player and video_uri %}
<div class="top-grid">
  <div>
    <div class="player"><video id="lsr-video" controls preload="metadata" src="{{ video_uri }}"></video></div>
    <div class="player-note">Click any timestamp, chart marker or screenshot to jump to that moment.</div>
  </div>
  {% include "_overview.html.j2" %}
</div>
{% else %}
{% include "_overview.html.j2" %}
{% endif %}
{% endif %}

<div class="summary-grid{% if not embedded %} section{% endif %}">
  <div class="panel">
    <h2>Executive Summary</h2>
    <div class="summary-text">{{ r.incident_summary }}</div>
  </div>
  <div class="panel">
    <h2>Key Findings</h2>
    <ul>{% for f in r.key_findings %}<li>{{ f }}</li>{% else %}<li>See violation details below.</li>{% endfor %}</ul>
  </div>
  <div class="panel">
    <h2>Immediate Actions</h2>
    <ul>{% for a in r.immediate_actions_required %}<li>{{ a }}</li>{% else %}<li>Review the violations below and act on each.</li>{% endfor %}</ul>
  </div>
</div>

<div class="section">
  <h2>Violations ({{ r.total_violations }})</h2>
  {% if violations %}
  <div class="v-grid">
  {% for item in violations %}
  {% set v = item.v %}
  <div class="violation-card{% if v.review_status == 'false_alarm' %} is-false-alarm{% endif %}" id="v-{{ v.violation_id }}">
    <div class="v-top">
      <span class="badge" style="background:{{ item.color }}">{{ v.severity|upper }}</span>
      <h3>{{ v.violation_type }}</h3>
      <span class="v-timestamp seek" role="button" tabindex="0" data-seek="{{ item.ts }}" title="Jump to this moment">⏱ {{ item.ts_label }} ▶</span>
    </div>
    {% if item.people %}
    <div class="people">{% for who in item.people %}<span class="person" title="{{ who.label }} — {{ who.issues }}">👤 {{ who.label }}</span>{% endfor %}</div>
    {% endif %}
    <div class="v-body{% if not item.thumb %} no-shot{% endif %}">
      {% if item.thumb %}
      <div class="v-shot">
        <img class="seek" data-seek="{{ item.ts }}" src="{{ item.thumb }}" alt="Video frame at {{ item.ts_label }}" loading="lazy">
        <div class="cap">Frame @ {{ item.ts_label }} — click to play</div>
      </div>
      {% endif %}
      <div>
        <div class="source-tag">{{ item.rule_source }}</div>
        <div class="rule-box" title="{{ v.rule_violated }}"><div class="clamp-3"><strong>Rule:</strong> {{ v.rule_violated }}</div></div>
        <div class="explanation clamp-4" title="{{ v.explanation }}">{{ v.explanation }}</div>
      </div>
    </div>
    {% if v.immediate_action %}<div class="immediate-line"><strong>⚡ Now:</strong> {{ v.immediate_action }}</div>{% endif %}
    {% if item.repeats %}
    <div class="repeats">↻ Also seen at ({{ item.repeats|length }}, not flagged again):
      {% for rep in item.repeats %}<span class="repeat-chip seek" role="button" tabindex="0" data-seek="{{ rep.ts }}" title="Jump to {{ rep.label }}">{{ rep.label }}</span>{% endfor %}
    </div>
    {% endif %}
    <details>
      <summary>Details — full rule, corrective actions &amp; evidence</summary>
      <div class="full-text"><strong>Rule:</strong> {{ v.rule_violated }}</div>
      <div class="full-text">{{ v.explanation }}</div>
      <div class="actions">
        <div class="action-box recommended"><strong>🔧 Recommended</strong><span>{{ v.recommended_action or "—" }}</span></div>
        <div class="action-box preventive"><strong>🛡 Preventive</strong><span>{{ v.preventive_measure or "—" }}</span></div>
      </div>
      <h4>Manual / SOP evidence</h4>
      {% for ev in v.sop_evidence[:2] %}
        <div class="evidence-box"><strong>{{ ev.chunk.title }}</strong> (score {{ "%.2f"|format(ev.score) }})<br>{{ ev.chunk.content[:350] }}…</div>
      {% else %}
        <div class="evidence-box">No SOP evidence retrieved.</div>
      {% endfor %}
      <h4>Similar past incidents</h4>
      {% for ev in v.similar_incidents[:2] %}
        <div class="evidence-box"><strong>{{ ev.chunk.title }}</strong> (score {{ "%.2f"|format(ev.score) }})<br>{{ ev.chunk.content[:300] }}…</div>
      {% else %}
        <div class="evidence-box">No similar incidents found.</div>
      {% endfor %}
    </details>
    <div class="review">
      <span class="review-status" style="background:{{ item.review_color }}">{{ item.review_label }}</span>
      {% if v.reviewed_at %}<span style="color:var(--muted)">{{ v.reviewed_at.strftime('%Y-%m-%d %H:%M UTC') }}</span>{% endif %}
      {% if interactive %}
        <span style="flex:1"></span>
        <span role="button" tabindex="0" class="review-btn{% if v.review_status == 'confirmed' %} active{% endif %}"
              data-review="{{ r.report_id }}|{{ v.violation_id }}|confirmed">✓ Confirm</span>
        <span role="button" tabindex="0" class="review-btn{% if v.review_status == 'false_alarm' %} active{% endif %}"
              data-review="{{ r.report_id }}|{{ v.violation_id }}|false_alarm">✗ False alarm</span>
        {% if v.review_status != 'pending' %}
        <span role="button" tabindex="0" class="review-btn" data-review="{{ r.report_id }}|{{ v.violation_id }}|pending">↺ Undo</span>
        {% endif %}
      {% endif %}
    </div>
  </div>
  {% endfor %}
  </div>
  {% else %}
  <div class="panel" style="color:var(--muted)">No violations confirmed in this incident.</div>
  {% endif %}
</div>

<div class="section panel">
  <details>
    <summary>All flagged moments ({{ events|length }}) — full timeline table</summary>
    <table>
      <thead><tr><th>Time</th><th>Observation</th><th>Objects / Materials</th><th>Severity</th></tr></thead>
      <tbody>
      {% for e in events %}
        <tr{% if e.false_alarm %} class="is-false-alarm"{% endif %}>
          <td><span class="ts-link seek" data-seek="{{ e.ts }}" title="Jump to {{ e.ts_label }}">▶ {{ e.ts_label }}</span></td>
          <td>{{ e.description }}{% if e.people %}<br><span style="color:#fdba74;font-size:0.9em">👤 {{ e.people }}</span>{% endif %}{% if e.repeats %}<br><span style="color:#94a3b8;font-size:0.9em">↻ also seen {{ e.repeats }}×</span>{% endif %}</td>
          <td style="color:#64748b">{{ e.objects or "—" }}</td>
          <td><span class="badge" style="background:{{ e.color }}">{{ e.severity|upper }}</span></td>
        </tr>
      {% else %}
        <tr><td colspan="4" style="text-align:center;color:#64748b;font-style:italic">No violations detected in timeline</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </details>
</div>

{% if not embedded %}
<div class="footer">Generated by LabSentinel-RAG · {{ r.video_path }}</div>
{% endif %}
</div>

{% if not embedded %}
{% if include_player and video_uri %}
<script>
document.addEventListener('click', function (e) {
  var el = e.target.closest ? e.target.closest('[data-seek]') : null;
  if (!el) return;
  var v = document.getElementById('lsr-video');
  if (!v) return;
  v.currentTime = parseFloat(el.getAttribute('data-seek')) || 0;
  v.play();
  v.scrollIntoView({ behavior: 'smooth', block: 'center' });
});
</script>
{% endif %}
</body>
</html>
{% endif %}
