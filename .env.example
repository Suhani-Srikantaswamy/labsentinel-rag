# LabSentinel-RAG — copy to .env and fill in. Never commit .env.

# Gemini (free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-key-here
# Optional extra keys for automatic rotation when one hits its daily quota
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=

# Optional: OpenAI instead of Gemini
# OPENAI_API_KEY=
# LABSENTINEL_PROVIDER=auto          # auto | gemini | openai

# Model
# LABSENTINEL_GEMINI_MODEL=gemini-3.5-flash

# Reliability
# LABSENTINEL_THINKING_HEADROOM=3072 # extra output tokens reserved for model "thinking"
# LABSENTINEL_THINKING_BUDGET=       # optional hard cap on thinking tokens
# LABSENTINEL_REQUEST_TIMEOUT=120    # seconds per API call
# LABSENTINEL_TRANSIENT_RETRIES=4    # retries on 503/500/timeouts

# Speed (free tier): several frames per request, several requests at once
# LABSENTINEL_FRAMES_PER_REQUEST=6   # consecutive frames analysed together
# LABSENTINEL_EVENTS_PER_REQUEST=5   # flagged moments verified together
# LABSENTINEL_PARALLEL_REQUESTS=8    # max requests in flight
# LABSENTINEL_REQUESTS_PER_KEY=3     # in-flight requests per usable key

# Video analysis
# LABSENTINEL_FRAME_RATE=6           # minimum spacing between evenly spaced frames (s)
# LABSENTINEL_MAX_FRAMES=auto        # auto = scales with video length (or a fixed number)
# LABSENTINEL_AUTO_FRAME_SPACING=10  # auto: one frame per N seconds …
# LABSENTINEL_AUTO_MIN_FRAMES=24     # … but at least this many
# LABSENTINEL_AUTO_MAX_FRAMES=90     # … and at most this many
# LABSENTINEL_CHUNK_SEC=180         # long videos are split into chunks of N seconds (2s overlap)
# LABSENTINEL_MOTION_THRESHOLD=10.0

# Retrieval
# LABSENTINEL_EMBED_MODEL=all-MiniLM-L6-v2
# LABSENTINEL_TOP_K_SOPS=5
# LABSENTINEL_SIM_THRESHOLD=0.20

# Output
# LABSENTINEL_OUTPUT_FORMATS=json,html,pdf
