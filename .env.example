# ─────────────────────────────────────────────────────────────────────────────
# LabSentinel-RAG — Environment Configuration
# Copy this file:  cp .env.example .env
# Then fill in ONE of the two API keys below.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# OPTION 1 — Google Gemini (FREE — no credit card needed)
# ══════════════════════════════════════════════════════════════════════════════
# 1. Go to https://aistudio.google.com
# 2. Click "Get API key" → "Create API key"
# 3. Paste it below:
#GOOGLE_API_KEY=your-gemini-api-key-here

# Free tier limits (more than enough for testing):
#   gemini-1.5-flash : 15 requests/min · 1,000,000 tokens/day · FREE
#   gemini-1.5-pro   : 2 requests/min  · 50 requests/day      · FREE (slower)


# ══════════════════════════════════════════════════════════════════════════════
# OPTION 2 — OpenAI GPT-4o (PAID — ~$0.10-$0.30 per investigation)
# ══════════════════════════════════════════════════════════════════════════════
# 1. Go to https://platform.openai.com/api-keys
# 2. Click "Create new secret key"
# 3. Paste it below:
#OPENAI_API_KEY=sk-your-openai-api-key-here

# New accounts get $5 free credit (~20-50 investigations).


# ── PROVIDER SELECTION ────────────────────────────────────────────────────────
# auto   = use Gemini if GOOGLE_API_KEY set, else OpenAI (default)
# gemini = always use Gemini
# openai = always use OpenAI
#LABSENTINEL_PROVIDER=auto

# Gemini model (free tier) — gemini-2.5-flash supports vision
#LABSENTINEL_GEMINI_MODEL=gemini-2.5-flash

# OpenAI model (paid)
#LABSENTINEL_VLM_MODEL=gpt-4o
#LABSENTINEL_REASONING_MODEL=gpt-4o


# ── VIDEO ANALYSIS ────────────────────────────────────────────────────────────
# Analyse 1 frame every N seconds (3 = good balance, 1 = maximum accuracy)
#LABSENTINEL_FRAME_RATE=3

# Total frame cap (60 = default, 120 = high coverage for long videos)
#LABSENTINEL_MAX_FRAMES=60

# Motion sensitivity — lower = catches more subtle activity
#LABSENTINEL_MOTION_THRESHOLD=10.0

# Chunk size for long videos (seconds per chunk)
#LABSENTINEL_CHUNK_SEC=300

# Frame resolution
#LABSENTINEL_FRAME_WIDTH=1280
#LABSENTINEL_FRAME_HEIGHT=720


# ── RETRIEVAL ────────────────────────────────────────────────────────────────
# Local embedding model — runs offline, no API key needed
#LABSENTINEL_EMBED_MODEL=all-MiniLM-L6-v2
#LABSENTINEL_CHUNK_SIZE=512
#LABSENTINEL_CHUNK_OVERLAP=64
#LABSENTINEL_TOP_K_SOPS=5
#LABSENTINEL_TOP_K_MANUALS=4
#LABSENTINEL_TOP_K_INCIDENTS=3
#LABSENTINEL_SIM_THRESHOLD=0.20


# ── OUTPUT ────────────────────────────────────────────────────────────────────
#LABSENTINEL_OUTPUT_FORMATS=json,html,pdf
#LABSENTINEL_OUTPUT_DIR=outputs


# ── WEB UI ────────────────────────────────────────────────────────────────────
#GRADIO_PORT=7860
#GRADIO_SHARE=false
