# LabSentinel-RAG — copy to .env and fill in. Never commit .env.

# Gemini (free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-key-here
# Optional extra keys for automatic rotation when one hits its daily quota
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=

# Optional: OpenAI instead of Gemini
# OPENAI_API_KEY=
# LABSENTINEL_PROVIDER=auto          # auto | gemini | openai

# Model
# LABSENTINEL_GEMINI_MODEL=gemini-3.5-flash

# Reliability
# LABSENTINEL_THINKING_HEADROOM=3072 # extra output tokens reserved for model "thinking"
# LABSENTINEL_THINKING_BUDGET=       # optional hard cap on thinking tokens
# LABSENTINEL_REQUEST_TIMEOUT=120    # seconds per API call
# LABSENTINEL_TRANSIENT_RETRIES=4    # retries on 503/500/timeouts

# Video analysis
# LABSENTINEL_FRAME_RATE=6           # baseline: 1 frame every N seconds
# LABSENTINEL_MAX_FRAMES=24          # total frame budget per video
# LABSENTINEL_CHUNK_SEC=180
# LABSENTINEL_MOTION_THRESHOLD=10.0

# Retrieval
# LABSENTINEL_EMBED_MODEL=all-MiniLM-L6-v2
# LABSENTINEL_TOP_K_SOPS=5
# LABSENTINEL_SIM_THRESHOLD=0.20

# Output
# LABSENTINEL_OUTPUT_FORMATS=json,html,pdf
