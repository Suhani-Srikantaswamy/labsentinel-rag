# ─────────────────────────────────────────────────────────────────────────────
# LabSentinel-RAG — Environment Configuration
# Copy this file:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# GOOGLE GEMINI API KEYS (FREE — no credit card needed)
# ══════════════════════════════════════════════════════════════════════════════
# Get free keys at: https://aistudio.google.com/apikey
# One key per Google account. Keys auto-rotate when quota is hit.
#
# Free tier: ~20 requests/day per key
# With 10 keys: ~200 requests/day = ~12 full investigations/day FREE
#
# Add as many keys as you want — the system handles rotation automatically.
# Keys are tried in order (1 → 2 → 3 → ...) when quota is exhausted.

GOOGLE_API_KEY=your-first-gemini-key-here
# GOOGLE_API_KEY_2=your-second-key
# GOOGLE_API_KEY_3=your-third-key
# GOOGLE_API_KEY_4=your-fourth-key
# GOOGLE_API_KEY_5=your-fifth-key
# GOOGLE_API_KEY_6=your-sixth-key
# GOOGLE_API_KEY_7=your-seventh-key
# GOOGLE_API_KEY_8=your-eighth-key
# GOOGLE_API_KEY_9=your-ninth-key
# GOOGLE_API_KEY_10=your-tenth-key
# ... you can keep adding more (GOOGLE_API_KEY_11, _12, etc.)


# ══════════════════════════════════════════════════════════════════════════════
# OPENAI (PAID — optional alternative to Gemini)
# ══════════════════════════════════════════════════════════════════════════════
# New accounts get $5 free credit (~20-30 investigations)
# Get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key-here


# ══════════════════════════════════════════════════════════════════════════════
# PROVIDER SELECTION
# ══════════════════════════════════════════════════════════════════════════════
# auto   = use Gemini if GOOGLE_API_KEY set, else OpenAI (default)
# gemini = always use Gemini
# openai = always use OpenAI
# LABSENTINEL_PROVIDER=auto

# Gemini model (free)
# LABSENTINEL_GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI model (paid)
# LABSENTINEL_VLM_MODEL=gpt-4o
# LABSENTINEL_REASONING_MODEL=gpt-4o


# ══════════════════════════════════════════════════════════════════════════════
# VIDEO ANALYSIS SETTINGS
# ══════════════════════════════════════════════════════════════════════════════
# Analyse 1 frame every N seconds (lower = more accurate, more API calls)
# LABSENTINEL_FRAME_RATE=3

# Total frame cap per video (raise for longer videos)
# LABSENTINEL_MAX_FRAMES=60

# Motion detection sensitivity (lower = catches more subtle activity)
# LABSENTINEL_MOTION_THRESHOLD=10.0

# Chunk size for long videos (seconds per chunk)
# LABSENTINEL_CHUNK_SEC=300


# ══════════════════════════════════════════════════════════════════════════════
# RETRIEVAL SETTINGS
# ══════════════════════════════════════════════════════════════════════════════
# LABSENTINEL_EMBED_MODEL=all-MiniLM-L6-v2
# LABSENTINEL_TOP_K_SOPS=5
# LABSENTINEL_TOP_K_MANUALS=4
# LABSENTINEL_TOP_K_INCIDENTS=3
# LABSENTINEL_SIM_THRESHOLD=0.20


# ══════════════════════════════════════════════════════════════════════════════
# OUTPUT SETTINGS
# ══════════════════════════════════════════════════════════════════════════════
# LABSENTINEL_OUTPUT_FORMATS=json,html,pdf
# LABSENTINEL_OUTPUT_DIR=outputs


# ══════════════════════════════════════════════════════════════════════════════
# WEB UI SETTINGS
# ══════════════════════════════════════════════════════════════════════════════
# GRADIO_PORT=7860
# GRADIO_SHARE=false
